{
	"name": "ILM-Cascade",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"build": "npm run typecheck && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
		"dev": "vite",
		"format": "biome format --write",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"preview": "vite preview",
		"test": "vitest",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"typecheck": "tsc --project tsconfig.app.json --noEmit",
		"i18n:fill": "node scripts/translate-locales.mjs",
		"i18n:check": "node scripts/translate-locales.mjs --check",
		"i18n:regenerate": "node scripts/translate-locales.mjs --force"
	},
